      "Operations": [
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 790,
          "Pos.y": 380,
          "Parent": -1,
          "#": 5,
          "Code.Type": "Global",
          "Code": [
            "int eidm_native_v3 = 3;",
            "int eidm_runtime_ready = 0;",
            "int eidm_runtime_ready_turn = 0;"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 820,
          "Pos.y": 380,
          "Parent": -1,
          "#": 6,
          "Code.Type": "Turn",
          "Code": [
            "if(CurTurn() <= 0) exit;",
            "",
            "int start_capital = 0;",
            "int current_capital = 0;",
            "int factor = 0;",
            "if(IsScriptActive('Mod_EvoFreeInflation'))",
            "{",
            "    start_capital = GetValueFromScript('Mod_EvoFreeInflation', 'start_capital_amount');",
            "    current_capital = GetValueFromScript('Mod_EvoFreeInflation', 'cur_capital_amount');",
            "    if(start_capital > 0 && current_capital > 0)",
            "    {",
            "        int evo_gtl = max(GalaxyTechLevel(), GetValueFromScript('Mod_EvoFreeInflation', 'max_reached_GTL'));",
            "        int tech_factor = round(PortionInDiapason(max(1, min(8, evo_gtl)), 1, 8, 100, 400));",
            "        int combined_factor = max(100, round(100.0 * current_capital / start_capital));",
            "        factor = max(100, round(100.0 * combined_factor / tech_factor));",
            "    }",
            "}",
            "else",
            "{",
            "    start_capital = round(PortionInDiapason(GalaxyDiffLevels(1), 50, 500, 75000, 10000));",
            "    current_capital = RangersCapital();",
            "    if(start_capital > 0 && current_capital > 0)",
            "        factor = max(100, round(100.0 * current_capital / start_capital));",
            "}",
            "",
            "unknown native_ready = ImportedFunction('XenoEquipmentInflationNative', 'XenoEquipmentInflation_IsReady');",
            "if(!native_ready()) exit;",
            "unknown native_configure = ImportedFunction('XenoEquipmentInflationNative', 'XenoEquipmentInflation_Configure');",
            "int configured = native_configure(",
            "    t_Artefact,",
            "    t_Hull,",
            "    t_Weapon1,",
            "    t_CustomWeapon,",
            "    t_ArtDefToEnergy,",
            "    t_ArtFastRacks,",
            "    80,",
            "    90,",
            "    100,",
            "    110);",
            "if(!configured || factor < 100) exit;",
            "unknown native_pulse = ImportedFunction('XenoEquipmentInflationNative', 'XenoEquipmentInflation_Pulse');",
            "native_pulse(factor);"
          ]
        },
        {
          "Type": "Top",
          "Name": "XenoEquipmentInflation_SelectLocal",
          "Pos.x": 820,
          "Pos.y": 380,
          "Parent": -1,
          "#": 8,
          "Code.Type": "Turn",
          "Code": [
            "if(!eidm_runtime_ready || CurTurn() <= eidm_runtime_ready_turn) exit;",
            "",
            "function EIDM_LocalMarketStep(dword shop, int cursor)",
            "{",
            "    if(!shop) exit;",
            "    int count = ShopItems(shop);",
            "    if(count <= 0) exit;",
            "    dword item = ShopItems(shop, cursor - (cursor / count) * count);",
            "    if(!item || ObjectType(item) != 6) exit;",
            "    int item_type = ItemType(item);",
            "    int is_equipment = item_type >= t_Artefact && item_type <= t_CustomWeapon;",
            "    int is_extended_artefact = item_type >= t_ArtDefToEnergy && item_type <= t_ArtFastRacks;",
            "    if(!is_equipment && !is_extended_artefact) exit;",
            "",
            "    int same_type_count = 0;",
            "    for(int i = 0; i < count; i = i + 1)",
            "    {",
            "        dword test_item = ShopItems(shop, i);",
            "        if(test_item && ItemType(test_item) == item_type)",
            "            same_type_count = same_type_count + 1;",
            "    }",
            "    int market_adjust = 0;",
            "    if(same_type_count <= 1) market_adjust = 20;",
            "    else if(same_type_count == 2) market_adjust = 15;",
            "    else if(same_type_count <= 4) market_adjust = 10;",
            "    else if(same_type_count <= 8) market_adjust = 0;",
            "    else if(same_type_count <= 12) market_adjust = -10;",
            "    else market_adjust = -20;",
            "",
            "    int level_delta = ItemLevel(item) - GalaxyTechLevel();",
            "    if(level_delta >= 2) market_adjust = market_adjust + 10;",
            "    else if(level_delta == 1) market_adjust = market_adjust + 5;",
            "    else if(level_delta <= -3) market_adjust = market_adjust - 10;",
            "    else if(level_delta == -2) market_adjust = market_adjust - 5;",
            "    market_adjust = max(-30, min(30, market_adjust));",
            "    unknown native_market = ImportedFunction('XenoEquipmentInflationNative', 'XenoEquipmentInflation_SetMarket');",
            "    native_market(item, 100 + market_adjust);",
            "}",
            "",
            "dword local_shop = GetShipRuins(Player());",
            "if(!local_shop) local_shop = GetShipPlanet(Player());",
            "if(!local_shop) exit;",
            "int local_cursor = (CurTurn() - 1) * 12;",
            "EIDM_LocalMarketStep(local_shop, local_cursor);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 1);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 2);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 3);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 4);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 5);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 6);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 7);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 8);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 9);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 10);",
            "EIDM_LocalMarketStep(local_shop, local_cursor + 11);"
          ]
        },
        {
          "Type": "Top",
          "Name": "XenoEquipmentInflation_SelectRemote",
          "Pos.x": 820,
          "Pos.y": 380,
          "Parent": -1,
          "#": 9,
          "Code.Type": "Turn",
          "Code": [
            "if(!eidm_runtime_ready || CurTurn() <= eidm_runtime_ready_turn) exit;",
            "",
            "function EIDM_RemoteMarketStep(int batch_offset)",
            "{",
            "    int total_stars = GalaxyStars();",
            "    if(total_stars <= 0) exit;",
            "    int tick = ((CurTurn() - 1) / 5) * 12 + batch_offset;",
            "    int star_index = tick - (tick / total_stars) * total_stars;",
            "    dword star = GalaxyStar(star_index);",
            "    if(!star) exit;",
            "",
            "    int planet_count = StarPlanets(star);",
            "    int ruin_count = StarRuins(star);",
            "    int total_shops = planet_count + ruin_count;",
            "    if(total_shops <= 0) exit;",
            "    int shop_cycle = tick / total_stars;",
            "    int shop_index = shop_cycle - (shop_cycle / total_shops) * total_shops;",
            "    dword shop = 0;",
            "    if(shop_index < planet_count) shop = StarPlanets(star, shop_index);",
            "    else shop = StarRuins(star, shop_index - planet_count);",
            "    if(!shop) exit;",
            "",
            "    int count = ShopItems(shop);",
            "    if(count <= 0) exit;",
            "    int item_cycle = shop_cycle / total_shops;",
            "    dword item = ShopItems(shop, item_cycle - (item_cycle / count) * count);",
            "    if(!item || ObjectType(item) != 6) exit;",
            "    int item_type = ItemType(item);",
            "    int is_equipment = item_type >= t_Artefact && item_type <= t_CustomWeapon;",
            "    int is_extended_artefact = item_type >= t_ArtDefToEnergy && item_type <= t_ArtFastRacks;",
            "    if(!is_equipment && !is_extended_artefact) exit;",
            "",
            "    int same_type_count = 0;",
            "    for(int i = 0; i < count; i = i + 1)",
            "    {",
            "        dword test_item = ShopItems(shop, i);",
            "        if(test_item && ItemType(test_item) == item_type)",
            "            same_type_count = same_type_count + 1;",
            "    }",
            "    int market_adjust = 0;",
            "    if(same_type_count <= 1) market_adjust = 20;",
            "    else if(same_type_count == 2) market_adjust = 15;",
            "    else if(same_type_count <= 4) market_adjust = 10;",
            "    else if(same_type_count <= 8) market_adjust = 0;",
            "    else if(same_type_count <= 12) market_adjust = -10;",
            "    else market_adjust = -20;",
            "",
            "    int level_delta = ItemLevel(item) - GalaxyTechLevel();",
            "    if(level_delta >= 2) market_adjust = market_adjust + 10;",
            "    else if(level_delta == 1) market_adjust = market_adjust + 5;",
            "    else if(level_delta <= -3) market_adjust = market_adjust - 10;",
            "    else if(level_delta == -2) market_adjust = market_adjust - 5;",
            "    market_adjust = max(-30, min(30, market_adjust));",
            "    unknown native_market = ImportedFunction('XenoEquipmentInflationNative', 'XenoEquipmentInflation_SetMarket');",
            "    native_market(item, 100 + market_adjust);",
            "}",
            "",
            "if((CurTurn() - 1) % 5) exit;",
            "EIDM_RemoteMarketStep(0);",
            "EIDM_RemoteMarketStep(1);",
            "EIDM_RemoteMarketStep(2);",
            "EIDM_RemoteMarketStep(3);",
            "EIDM_RemoteMarketStep(4);",
            "EIDM_RemoteMarketStep(5);",
            "EIDM_RemoteMarketStep(6);",
            "EIDM_RemoteMarketStep(7);",
            "EIDM_RemoteMarketStep(8);",
            "EIDM_RemoteMarketStep(9);",
            "EIDM_RemoteMarketStep(10);",
            "EIDM_RemoteMarketStep(11);"
          ]
        },
        {
          "Type": "Top",
          "Name": "XenoEquipmentInflation_Market",
          "Pos.x": 820,
          "Pos.y": 380,
          "Parent": -1,
          "#": 10,
          "Code.Type": "Turn",
          "Code": [
            "if(!eidm_runtime_ready || CurTurn() <= eidm_runtime_ready_turn) exit;",
            "",
            "if(CurTurn() < 301 || ((CurTurn() - 301) % 300)) exit;",
            "int news_factor = 100;",
            "int news_start = 0;",
            "int news_capital = 0;",
            "if(IsScriptActive('Mod_EvoFreeInflation'))",
            "{",
            "    news_start = GetValueFromScript('Mod_EvoFreeInflation', 'start_capital_amount');",
            "    news_capital = GetValueFromScript('Mod_EvoFreeInflation', 'cur_capital_amount');",
            "    if(news_start > 0 && news_capital > 0)",
            "    {",
            "        int news_gtl = max(GalaxyTechLevel(), GetValueFromScript('Mod_EvoFreeInflation', 'max_reached_GTL'));",
            "        int news_tech = round(PortionInDiapason(max(1, min(8, news_gtl)), 1, 8, 100, 400));",
            "        int news_combined = max(100, round(100.0 * news_capital / news_start));",
            "        news_factor = max(100, round(100.0 * news_combined / news_tech));",
            "    }",
            "}",
            "else",
            "{",
            "    news_start = round(PortionInDiapason(GalaxyDiffLevels(1), 50, 500, 75000, 10000));",
            "    news_capital = RangersCapital();",
            "    if(news_start > 0 && news_capital > 0)",
            "        news_factor = max(100, round(100.0 * news_capital / news_start));",
            "}",
            "if(news_factor >= 300)",
            "    AddPlanetNews(Format(CT('XenoEquipmentInflation.InflationNewsHigh'), '#factor#', news_factor), 23);",
            "else if(news_factor >= 150)",
            "    AddPlanetNews(Format(CT('XenoEquipmentInflation.InflationNewsGrowing'), '#factor#', news_factor), 23);",
            "else",
            "    AddPlanetNews(Format(CT('XenoEquipmentInflation.InflationNewsStable'), '#factor#', news_factor), 23);"
          ]
        },
        {
          "Type": "Top",
