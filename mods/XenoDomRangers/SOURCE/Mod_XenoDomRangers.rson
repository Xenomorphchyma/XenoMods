      "Stars": [
        {
          "Type": "TStar",
          "Name": "StarAnchor",
          "Pos.x": 760,
          "Pos.y": 410,
          "Parent": -1,
          "#": 4,
          "Constellation": 0,
          "Priority": 0,
          "NoKling": false,
          "NoComeKling": false
        }
      ],
      "States": [
        {
          "Type": "TState",
          "Name": "XenoDomState",
          "Pos.x": 760,
          "Pos.y": 500,
          "Parent": -1,
          "#": 2,
          "Move": 0,
          "MoveObj": -1,
          "Attack.Count": 0,
          "TakeItem": -1,
          "TakeAllItem": false,
          "OnTalk": "",
          "OnActCode": "[t_OnStep,t_OnChameleonConfusion,t_OnWeaponShot,t_OnMissileShot,t_OnGettingWeaponHit,t_OnGettingMissileHit|]\nfunction XDR_StateSlotByShip(dword state_checked_ship)\n{\n    result = 0;\n    if(!state_checked_ship || ArrayDim(xdr_ids) != 4) exit;\n    int state_checked_id = Id(state_checked_ship);\n    if(xdr_ids[1] == state_checked_id) { result = 1; exit; }\n    if(xdr_ids[2] == state_checked_id) { result = 2; exit; }\n    if(xdr_ids[3] == state_checked_id) { result = 3; exit; }\n}\nfunction XDR_StateIsMasked(dword state_checked_ship)\n{\n    result = 0;\n    int state_checked_slot = XDR_StateSlotByShip(state_checked_ship);\n    if(state_checked_slot > 0 && ArrayDim(xdr_ghost_flags) == 4) result = xdr_ghost_flags[state_checked_slot];\n}\nfunction XDR_StateDialogMarker(dword state_checked_ship)\n{\n    result = 0;\n    int state_checked_slot = XDR_StateSlotByShip(state_checked_ship);\n    if(state_checked_slot > 0 && ArrayDim(xdr_dialog_markers) == 4) result = xdr_dialog_markers[state_checked_slot];\n}\nfunction XDR_StateSetDialogMarker(dword state_checked_ship, int state_marker)\n{\n    int state_checked_slot = XDR_StateSlotByShip(state_checked_ship);\n    if(state_checked_slot > 0 && ArrayDim(xdr_dialog_markers) == 4) xdr_dialog_markers[state_checked_slot] = state_marker;\n}\nfunction XDR_StateStopNpcOffense(dword state_npc_ship)\n{\n    if(!state_npc_ship) exit;\n    dword state_npc_bad = ShipGetBad(state_npc_ship);\n    dword state_npc_order_target = ShipOrderObj(state_npc_ship);\n    if(state_npc_bad) ShipSetBad(state_npc_ship, 0);\n    if(state_npc_bad && state_npc_order_target == state_npc_bad) OrderNone(state_npc_ship);\n    int state_npc_weapon_count = ShipCntWeapon(state_npc_ship);\n    for(int state_npc_weapon_index = 1; state_npc_weapon_index <= state_npc_weapon_count; state_npc_weapon_index = state_npc_weapon_index + 1)\n    {\n        dword state_npc_weapon = ShipWeapon(state_npc_ship, state_npc_weapon_index);\n        if(state_npc_weapon && WeaponTarget(state_npc_weapon)) WeaponTarget(state_npc_weapon, 0);\n    }\n}\nif(ScriptItemActionType(t_OnGettingWeaponHit) || ScriptItemActionType(t_OnGettingMissileHit))\n{\n    if(CurShip == Player() || !XDR_StateIsMasked(CurShip)) exit;\n    if(ScriptItemActObject1() != Player()) exit;\n    int xdr_hit_marker = XDR_StateDialogMarker(CurShip);\n    if(xdr_hit_marker == 3)\n    {\n        XDR_StateSetDialogMarker(CurShip, 1);\n        XDR_StateStopNpcOffense(CurShip);\n        exit;\n    }\n    if(xdr_hit_marker == 1 || xdr_hit_marker == 4) exit;\n    XDR_StateSetDialogMarker(CurShip, 4);\n    XDR_StateStopNpcOffense(CurShip);\n    // Marker 4 is set before opening the modal window, so synchronous state\n    // re-entry cannot open a second copy of the warning. This event fires only\n    // after the engine has applied the real player hit.\n    Dialog(CurShip);\n    exit;\n}\nif(ScriptItemActionType(t_OnStep))\n{\n    // A masked stalker is a non-combat salvage ship. This runs before it can\n    // preserve or execute a vanilla combat target, while leaving explicit\n    // OrderMove/OrderJump mission navigation untouched.\n    if(XDR_StateIsMasked(CurShip)) XDR_StateStopNpcOffense(CurShip);\n    exit;\n}\nif(ScriptItemActionType(t_OnChameleonConfusion)) exit;\nif(ScriptItemActionType(t_OnWeaponShot))\n{\n    if(!XDR_StateIsMasked(CurShip)) exit;\n    // Action objects are not type-stable in every 2.1.2500 weapon path. Cancel\n    // the event and clear the installed weapons through the proven ship API.\n    XDR_StateStopNpcOffense(CurShip);\n    ScriptItemActParam(0);\n    exit;\n}\nif(ScriptItemActionType(t_OnMissileShot))\n{\n    if(!XDR_StateIsMasked(CurShip)) exit;\n    XDR_StateStopNpcOffense(CurShip);\n    ScriptItemActParam(0);\n    exit;\n}\n",
          "EType": 1,
          "EUnique": "",
          "EMsg": ""
        },
        {
          "Type": "TState",
          "Name": "XenoDomPlayerState",
          "Pos.x": 960,
          "Pos.y": 500,
          "Parent": -1,
          "#": 9,
          "Move": 0,
          "MoveObj": -1,
          "Attack.Count": 0,
          "TakeItem": -1,
          "TakeAllItem": false,
          "OnTalk": "",
          "OnActCode": "[t_OnEnteringForm|]\nif(!ScriptItemActionType(t_OnEnteringForm)) exit;\nif(CurShip != Player()) exit;\nif(!xdr_ui_ready)\n{\n    xdr_ui_ready = 1;\n    xdr_ui_ready_turn = CurTurn();\n}\n",
          "EType": 1,
          "EUnique": "",
          "EMsg": ""
        }
      ],
