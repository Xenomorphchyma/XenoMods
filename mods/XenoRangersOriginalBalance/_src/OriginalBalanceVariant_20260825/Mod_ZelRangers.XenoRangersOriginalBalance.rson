        },
        {
          "Type": "TDialogMsg",
          "Name": "",
          "Pos.x": 780,
          "Pos.y": 450,
          "Parent": -1,
          "#": 73,
          "Msg": "Улучшение обойдётся в <cost> cr. Оплачиваем или снова попросим инженеров поработать за идею?",
          "DMsg.Num": "16"
        },
        {
