            "    }",
            "    if ((result == -1 || result == 0) && debug) {",
            "        SFT('[ZelRangers.RandomAcryn] Произошло что-то странное и акрин не выдался.');",
            "    }",
            "}",
            "",
            "// RandomAcrynPower(lvl)",
            "// RandomAcryn(lvl)",
            "",
            "// Рандомизация акрина;",
            "// rc - ЦР, на котором появится рейнджер",
            "// n - его номер (n=0,1,2,3,4)",
            "function RangerMoney(n) {",
            "    if (n == 0) result = money[0]; else",
            "    if (n == 1) result = money[1]; else",
            "    if (n == 2) result = money[2]; else",
            "    if (n == 3) result = money[3]; else",
            "    result = money[4];",
            "}",
            "",
            "function RangerHullSizeLevel(n) {",
            "    if (n == 0) result = LvlHullSize[0]; else",
            "    if (n == 1) result = LvlHullSize[1]; else",
            "    if (n == 2) result = LvlHullSize[2]; else",
            "    if (n == 3) result = LvlHullSize[3]; else",
            "    result = LvlHullSize[4];",
            "}",
            "",
            "function RangerAcrynLevel(n) {",
            "    if (n == 0) result = LvlHullAcrin[0]; else",
            "    if (n == 1) result = LvlHullAcrin[1]; else",
            "    if (n == 2) result = LvlHullAcrin[2]; else",
            "    if (n == 3) result = LvlHullAcrin[3]; else",
            "    result = LvlHullAcrin[4];",
            "}",
            "",
            "function RangerEquipmentLevel(n) {",
            "    if (n == 0) result = LvlEq[0]; else",
            "    if (n == 1) result = LvlEq[1]; else",
            "    if (n == 2) result = LvlEq[2]; else",
            "    if (n == 3) result = LvlEq[3]; else",
            "    result = LvlEq[4];",
            "}",
            "",
            "function BuyNewRanger(rc, n) {",
            "    ship = BuyRanger(StarPlanets(ShipStar(rc), Rnd(0, StarPlanets(ShipStar(rc)) - 1)), RangerMoney(n));",
            "",
            "    if (prob(0.25)) {",
            "        random = Rnd(Maloc, Gaal);",
            "        ShipPilotRace(ship, random);",
            "        ShipOwner(ship, random);",
            "        ItemOwner(ShipItems(ship, 0), random);",
            "        Chameleon(ship);",
            "    }",
            "",
            "    // Если игрок - пират, то и рейнджер - пират",
            "    //if (playerRace() == 7)",
            "    //    ShipOwner(ship, 7);",
            "",
            "    // Обработка корпуса Таухито ()",
            "    if (Chameleon(ship, 'GraphName') == 'Ship.People.RangerOldFag') {",
            "        //ItemOwner(ShipItems(ship, 0), None);",
            "        //ShipPilotRace(ship, Maloc); //choice5(1,Maloc,1,Peleng,0,People,1,Fei,1,Gaal));",
            "        //SFT('!' + Chameleon(ship, 'GraphName'));",
            "        //Chameleon(ship, 'Ship.Maloc.Ranger');",
            "        //HullSeries(ShipItems(ship, 0), 80);",
            "        //SFT('!! ' + Chameleon(ship, 'GraphName'));",
            "        //SFT('!! ' + HullSeries(ShipItems(ship, 0)));",
            "    }",
            "",
            "    // Даем корпус с нужными параметрами",
            "    ItemSize(ShipItems(ship, 0), Rnd(0.75 * HullSize(n), 1.25 * HullSize(n)));",
            "    power = RandomAcrynPower(RangerAcrynLevel(n)); //сила акрина от 0 (нет акрина) до 4 (уникальный акрин)",
            "    //if (test) power = 4;",
            "    if (power != 0) {",
            "        acryn = RandomAcryn(power, ship, ShipOwner(ship));",
            "",
            "        //if (power == 1) {}",
            "        //if (power == 2) {}",
            "        //if (power == 3) {}",
            "        if (power == 4) {",
            "            admirals_cnt = admirals_cnt + 1;",
            "            ShipMoney(ship, round(6.0 * ShipMoney(ship))); // Повышаем капитал в 6.0 раз",
            "            while (ShipRank(ship) < 7) { // Повышаем звание до Адмирала",
            "                ShipRankPoints(ship, ShipNextRankPoints(ship));",
            "                ShipRaiseRank(ship);",
            "            }",
            "            ItemSize(ShipItems(ship, 0), round(1.3 * ItemSize(ShipItems(ship, 0)))); // Увеличиваем корпус на 30%",
            "        }",
            "",
            "        // Навешиваем акрин на корпус",
            "        if (acryn != -1 && acryn != 0) {",
            "            SpecialToEquipment(acryn, ShipItems(ship, 0));",
            "        }",
            "    }",
            "    HullHP(ship, ItemSize(ShipItems(ship, 0)));",
            "    Chameleon(ship);",
            "",
            "    // Удаляем всю оборудку",
            "    for (i = ShipItems(ship) - 1; i > 0; i = i - 1)",
            "        FreeItem(GetItemFromShip(ship, i));",
            "",
            "    // Даем новую оборудку",
            "    GiveAllEq(ship, RangerEquipmentLevel(n), toDiap(NItems + (power == 4), 1, 5));",
            "    ArrangeItems(ship);",
            "",
            "    // Улучшаем и тренируем рейнджера в соответствии с общими улучшениями отраслей",
            "    UpgradeShip(ship, toDiap(LvlUpgrade + (power == 4), 1, 5));",
            "    TrainShip(ship, toDiap(LvlSkills + (power == 4), 1, 5));",
            "",
            "    ShipRefit(ship);ShipRefit(ship); //рефитаем после выдачи и улучшения оборудки",
            "",
            "    // Перемещаем рейнджера в ЦР",
            "    TransferShip(ship, rc);",
            "}",
            "",
            "",
            "",
            "// BuyNewRanger(RC, n)",
            "",
            "// Функция создания рейнджера и изменения его характеристик;",
            "function HullSize(rangerN) {",
            "    result = ((1800.0 - GalaxyDiffLevels()) * (100.0 + GalaxyTechLevel() * 5.0) * (10.0 + 18.0 * RangerHullSizeLevel(rangerN))) / 20000.0;",
            "}",
            "",
            "function BuildingTime() {",
            "    result = ((12.0 + ShipPilotRace(Player())) * ((1000.0 + GalaxyDiffLevels()) * (30.0 - 5.0 * LvlFreq) * (GalaxyRangers() * 100.0 / (12.0 + 4.0 * LvlFreq)) + 1000000.0 - 100000.0 * LvlFreq) / 100000.0) / 10.0;",
            "    result = round(result);",
            "//    if (LvlFreq == 5) // Просьба Кота",
            "//        result = 0;",
            "}",
            "",
            "",
            "// HullSize(n)",
            "// BuildingTime()",
            "",
            "// Основные формулы;",
            "// Случайное действительно число от 0.0 до 1.0 с шагом 1e-9",
            "function random_real() {",
            "    result = 1.0 * Rnd(0, 1000000000) / 1000000000.0;",
            "}",
            "",
            "// Функции для взвешенного случайного выбора из нескольких значений (надеюсь я нигде не опечатался)",
            "// w1 - вес, a - значение",
            "// Сумма весов не обязательно равна 1",
            "function choice2(w1, a, w2, b) {",
            "    if (w1 + w2 == 0) {",
            "        result = choice2(1.0, a, 1.0, b);",
            "    } else {",
            "        if (random_real() < 1.0 * w1 / (0.0 + w1 + w2)) {",
            "            result = a;",
            "        } else {",
            "            result = b;",
            "        }",
            "    }",
            "}",
            "",
            "function choice4(w1, a, w2, b, w3, c, w4, d) {",
            "    result = choice2(",
            "        w1 + w2, choice2(w1, a, w2, b),",
            "        w3 + w4, choice2(w3, c, w4, d)",
            "    );",
            "}",
            "",
            "function choice8(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, w7, g, w8, h) {",
            "    result = choice2(",
            "        w1 + w2 + w3 + w4, choice4(w1, a, w2, b, w3, c, w4, d),",
            "        w5 + w6 + w7 + w8, choice4(w5, e, w6, f, w7, g, w8, h)",
            "    );",
            "}",
            "",
            "//function choice16(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, w7, g, w8, h, w9, i, w10, j, w11, k, w12, l, w13, m, w14, n, w15, p, w16, p) {",
            "//    result = choice2(",
            "//        w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8, choice8(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, w7, g, w8, h),",
            "//        w9 + w10 + w11 + w12 + w13 + w14 + w15 + w16, choice8(w9, i, w10, j, w11, k, w12, l, w13, m, w14, n, w15, p, w16, p)",
            "//    );",
            "//}",
            "",
            "function choice3(w1, a, w2, b, w3, c) {",
            "    result = choice4(w1, a, w2, b, w3, c, 0, 0);",
            "}",
            "",
            "function choice5(w1, a, w2, b, w3, c, w4, d, w5, e) {",
            "    result = choice8(w1, a, w2, b, w3, c, w4, d, w5, e, 0, 0, 0, 0, 0, 0);",
            "}",
            "",
            "function choice6(w1, a, w2, b, w3, c, w4, d, w5, e, w6) {",
            "    result = choice8(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, 0, 0, 0, 0);",
            "}",
            "",
            "function choice7(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, w7) {",
            "    result = choice8(w1, a, w2, b, w3, c, w4, d, w5, e, w6, f, w7, g, 0, 0);",
            "}",
            "",
            "// Приводит значение val к диапазону (mn,mx)",
            "function toDiap(val, mn, mx) {",
            "    result = min(max(val, mn), mx);",
            "    //result = choice3(",
            "    //    val < mn, mn,",
            "    //    val > mx, mx,",
            "    //    val >= mn && val <= mx, val",
            "    //);",
            "}",
            "",
            "// Возвращает истину (1) с вероятностью p, иначе - ложь (0)",
            "function prob(p) {",
            "    result = choice2(1.0 - p, 0, 0.0 + p, 1);",
            "}",
            "",
            "// random_real()",
            "// choiceN(weight_i, val_i, ...)",
            "// toDiap(val, min, max)",
            "// prob(p)",
            "",
            "// Функции для рандомизации;",
            "function RandomWeapon(race, bonus) {",
            "    // ВНИМАНИЕ ВНИМАНИЕ Я убрал проверку на принадлежность пушки какой-либо стороне. Рангеры могут заспавниться с пиратскими и домиковскими пушками!",
            "    // Подходящий тип: 1) ТУ появления < ГТУ + bonus; 2) ТУ появления > ГТУ + bonus - 3; 3) доступен для продажи и коалами, и пиратами",
            "    cnt = Rnd(t_Weapon1, t_Weapon18);",
            "test=0;//Правильная, но почему-то не работающая версия",
            "//    while (!(",
            "//            (GetCustomWeaponData(cnt, 'TechLevel') <= GalaxyTechLevel() + bonus)",
            "//            && (GetCustomWeaponData(cnt, 'TechLevel') >= GalaxyTechLevel() - 3)",
            "//            && (",
            "//                (GetCustomWeaponData(cnt, 'Availability') == 'Free')",
            "//                || ((GetCustomWeaponData(cnt, 'Availability') == 'CoalitionOnly') && (race <= Gaal))",
            "//                || ((GetCustomWeaponData(cnt, 'Availability') == 'PirateOnly') && (race == PirateClan))",
            "//            )",
            "//        ))",
            "    ",
            "    while (!(",
            "            (GetCustomWeaponData(cnt, 'TechLevel') <= max(2, GalaxyTechLevel() + bonus))",
            "            && (GetCustomWeaponData(cnt, 'TechLevel') >= GalaxyTechLevel() - 3)",
            "            && (",
            "                (cnt == t_Weapon1)",
            "                || (cnt == t_Weapon2)",
            "                || (cnt == t_Weapon3)",
            "                || (cnt == t_Weapon4)",
            "                || (cnt == t_Weapon5)",
            "                || (cnt == t_Weapon6)",
            "                || (cnt == t_Weapon7)",
            "                || (cnt == t_Weapon8)",
            "                || (cnt == t_Weapon9)",
            "                || (cnt == t_Weapon10)",
            "                || (cnt == t_Weapon11)",
            "                || (cnt == t_Weapon12)",
            "                //|| (cnt == t_Weapon13)",
            "                //|| (cnt == t_Weapon14)",
            "                //|| (cnt == t_Weapon15)",
            "                //|| (cnt == t_Weapon16)",
            "                //|| (cnt == t_Weapon17)",
            "                //|| (cnt == t_Weapon18)",
            "   )||test>99",
            "        ))",
            "{test=test+1;cnt=Rnd(t_Weapon1,t_Weapon9);}",
            "",
            "    size = round(0.01 * Rnd(67, 133) * GetCustomWeaponData(cnt, 'AverageSize')); // +-33% размера",
            "    power = GetCustomWeaponData(cnt, 'TechLevel');",
            "    power = 8.0 / (9.0 - power) * (GalaxyTechLevel() + bonus + 1 - power); // Рассчитываем ТУ пушки по ГТУ и ТУ ее появления",
            "    power = toDiap(round(power), 1, 8);",
            "    result = CreateEquipment(cnt, size, power, race);",
            "",
            "    if(!result){// Этого не должно происходить, но если произошло, то даем малокский промлазер 1ТУ весом 10",
            "        if (debug) SFT('[ZelRangers.RandomWeapon] Пушка не выдалась');",
            "        result = CreateEquipment(t_Weapon1, 10, 1, 0);",
            "    }",
            "}",
            "",
            "function RandomEqQuality(lvl) {",
            "    result = -1;",
            "",
            "    if (lvl == 1) {",
            "        result = choice3(",
            "            0.90, -1,",
            "            0.10, 0,",
            "            0.00, 1",
            "        );",
            "    } else if (lvl == 2) {",
            "        result = choice3(",
            "            0.65, -1,",
            "            0.25, 0,",
            "            0.10, 1",
            "        );",
            "    } else if (lvl == 3) {",
            "        result = choice3(",
            "            0.40, -1,",
            "            0.40, 0,",
            "            0.20, 1",
            "        );",
            "    } else if (lvl == 4) {",
            "        result = choice3(",
            "            0.10, -1,",
            "            0.60, 0,",
            "            0.30, 1",
            "        );",
            "    } else if (lvl == 5) {",
            "        result = choice3(",
            "            0.00, -1,",
            "            0.50, 0,",
            "            0.50, 1",
            "        );",
            "    }",
            "",
            "    if(result == -1 && debug){SFT('[ZelRangers.RandomEqQuality] result==-1');} // Это произойдет, если был получем lvl не из множества {1,2,3,4,5}",
            "}",
            "",
            "function GiveEq(ship, type, size, lvl) {",
            "    //SFT('[GiveEq] ship id: ' + Id(ship) + ' type: ' + type + ' size: ' + size + ' lvl:' + lvl);",
            "    if (type == t_Weapon1) {",
            "        item = RandomWeapon(ShipOwner(ship), RandomEqQuality(lvl));",
            "    } else {",
            "        item = CreateEquipment(type, round(0.01 * Rnd(80, 120) * size), toDiap(GalaxyTechLevel() + RandomEqQuality(lvl), 1, 8), ShipOwner(ship));",
            "    }",
            "    AddItemToShip(ship, item);",
            "}",
            "",
            "",
            "function GiveAllEq(ship, lvl, itemsCnt) {",
            "    // Задолбаюсь тут все комментировать, и так по коду понятно)",
            "",
            "    GiveEq(ship, t_Engine, Rnd(20, 50), lvl);",
            "    GiveEq(ship, t_FuelTanks, Rnd(20, 50), lvl);",
            "    GiveEq(ship, t_CargoHook, Rnd(20, 50), lvl);",
            "    GiveEq(ship, t_Weapon1, 1, lvl);",
            "",
            "    if (itemsCnt == 1) { //все и так уже выдано",
            "    } else if (itemsCnt == 2) {",
            "        if (prob(0.50))",
            "            GiveEq(ship, t_Radar, Rnd(15, 40), lvl);",
            "        else",
            "            GiveEq(ship, t_Weapon1, 1, lvl);",
            "    } else if (itemsCnt == 3) {",
            "        GiveEq(ship, t_Weapon1, 1, lvl);",
            "        GiveEq(ship, t_Radar, Rnd(15, 40), lvl);",
            "        if (prob(0.50)) {",
            "            random = choice4(",
            "                0.25, 0,",
            "                0.25, 1,",
            "                0.25, 2,",
            "                0.25, 3",
            "            );",
            "            if (random == 0) GiveEq(ship, t_Weapon1, 1, lvl); else",
            "            if (random == 1) GiveEq(ship, t_Scaner, Rnd(15, 40), lvl); else",
            "            if (random == 2) GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl); else",
            "            if (random == 3) GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "        }",
            "    } else if (itemsCnt == 4) {",
            "        GiveEq(ship, t_Weapon1, 1, lvl);",
            "        GiveEq(ship, t_Radar, Rnd(15, 40), lvl);",
            "        if (prob(0.5)) {",
            "            random = Rnd(0, 3);",
            "            if (random == 0) GiveEq(ship, t_Weapon1, 1, lvl); else",
            "            if (random == 1) GiveEq(ship, t_Scaner, Rnd(15, 40), lvl); else",
            "            if (random == 2) GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl); else",
            "            if (random == 3) GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "        } else {",
            "            random = Rnd(0, 3);",
            "            if (random == 0) {",
            "                GiveEq(ship, t_Weapon1, 1, lvl);",
            "                GiveEq(ship, t_Scaner, Rnd(15, 40), lvl);",
            "            } else if (random == 1) {",
            "                GiveEq(ship, t_Scaner, Rnd(15, 40), lvl);",
            "                GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl);",
            "            } else if (random == 2) {",
            "                GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl);",
            "                GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "            } else if (random == 3/*кто-то это читает?*/) {",
            "                GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "                GiveEq(ship, t_Weapon1, 1, lvl);",
            "            }",
            "        }",
            "    } else if (itemsCnt == 5){",
            "        GiveEq(ship, t_Weapon1, 1, lvl);",
            "        GiveEq(ship, t_Weapon1, 1, lvl);",
            "        GiveEq(ship, t_Radar, Rnd(15, 40), lvl);",
            "",
            "        if (prob(0.50)) {",
            "            random = Rnd(0, 3);",
            "            if (random == 0) {",
            "                GiveEq(ship, t_Weapon1, 1, lvl);",
            "                GiveEq(ship, t_Scaner, Rnd(15, 40), lvl);",
            "            } else if (random == 1) {",
            "                GiveEq(ship, t_Scaner, Rnd(15, 40), lvl);",
            "                GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl);",
            "            } else if (random == 2) {",
            "                GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl);",
            "                GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "            } else if (random == 3) {",
            "                GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "                GiveEq(ship, t_Weapon1, 1, lvl);",
            "            }",
            "        } else {",
            "            GiveEq(ship, t_Weapon1, 1, lvl);",
            "            GiveEq(ship, t_Scaner, Rnd(15, 40), lvl);",
            "            GiveEq(ship, t_DefGenerator, Rnd(20, 50), lvl);",
            "            GiveEq(ship, t_RepairRobot, Rnd(20, 50), lvl);",
            "        }",
            "    }",
            "}",
            "",
            "// Тренирует рейнджера",
            "function TrainShip(ship, lvl) {",
            "    result = 0;",
            "",
            "    if (lvl == 1) {",
            "        result = choice2(",
            "            0.67, 0,",
            "            0.33, 1",
            "        );",
            "    } else if (lvl == 2) {",
            "        result = choice3(",
            "            0.25, 0,",
            "            0.25, 1,",
            "            0.50, 2",
            "        );",
            "    } else if (lvl == 3) {",
            "        result = choice3(",
            "            0.57, 1,",
            "            0.28, 2,",
            "            0.14, 3",
            "        );",
            "    } else if (lvl == 4) {",
            "        result = choice4(",
            "            0.17, 1,",
            "            0.33, 2,",
            "            0.33, 3,",
            "            0.17, 4",
            "        );",
            "    } else if (lvl == 5) {",
            "        result = choice3(",
            "            0.55, 3,",
            "            0.22, 4,",
            "            0.22, 5",
            "        );",
            "    }",
            "    for (i = 0; i <= 5; i = i + 1)",
            "        ShipSkill(ship, i, toDiap(result + Rnd(-1, 1), 1, 6)); //Добавил рандомизацию +-1 уровень навыка",
            "}",
            "",
            "// Улучшает оборудку на корабле несколько раз",
            "function UpgradeShip(ship, lvl) {",
            "    if (lvl == 1) ShipImproveItems(ship, Rnd(1, 1)); else",
            "    if (lvl == 2) ShipImproveItems(ship, Rnd(2, 3)); else",
            "    if (lvl == 3) ShipImproveItems(ship, Rnd(3, 5)); else",
            "    if (lvl == 4) ShipImproveItems(ship, Rnd(5, 8)); else",
            "    if (lvl == 5) ShipImproveItems(ship, Rnd(8, 12));",
            "}",
            "",
            "// RandomWeapon()",
            "// GiveEq(ship, eq_type, eq_size, eq_lvl)",
            "// GiveAllEq(ship, lvl, eq_cnt)",
            "// Trainship(ship, lvl)",
            "// Upgradeship(ship, lvl)",
            "",
            "// Улучшение характеристик корабля;",
            "// множитель стоимости каждого улучшения",
            "branch_cost = newarray(8);",
            "branch_cost[0] = 40;",
            "branch_cost[1] = 60;",
            "branch_cost[2] = 30;",
            "branch_cost[3] = 50;",
            "branch_cost[4] = 20;",
            "branch_cost[5] = 6;",
            "branch_cost[6] = 10;",
            "branch_cost[7] = 8;",
            "",
            "// бонус к капиталу от каждого улучшения",
            "branch_money_bonus = newarray(8);",
            "branch_money_bonus[0] = 4;",
            "branch_money_bonus[1] = 6;",
            "branch_money_bonus[2] = 3;",
            "branch_money_bonus[3] = 5;",
            "branch_money_bonus[4] = 2;",
            "branch_money_bonus[5] = 3;",
            "branch_money_bonus[6] = 5;",
            "branch_money_bonus[7] = 4;",
            "",
            "// приращение cost_multiplier при каждом улучшении",
            "branch_cost_multiplier_inc = newarray(8);",
            "branch_cost_multiplier_inc[0] = 0;",
            "branch_cost_multiplier_inc[1] = 0;",
            "branch_cost_multiplier_inc[2] = 0;",
            "branch_cost_multiplier_inc[3] = 0;",
            "branch_cost_multiplier_inc[4] = 0;",
            "branch_cost_multiplier_inc[5] = 0;",
            "branch_cost_multiplier_inc[6] = 0;",
            "branch_cost_multiplier_inc[7] = 0;",
            "branch_cost_multiplier_inc[0] = 0.4;",
            "branch_cost_multiplier_inc[1] = 0.6;",
            "branch_cost_multiplier_inc[2] = 0.3;",
            "branch_cost_multiplier_inc[3] = 0.5;",
            "branch_cost_multiplier_inc[4] = 0.2;",
            "branch_cost_multiplier_inc[5] = 0.06;",
            "branch_cost_multiplier_inc[6] = 0.10;",
            "branch_cost_multiplier_inc[7] = 0.08;",
            "buy_date = CurTurn(); // дата последней постройки кораблей",
            "//cost_multiplier = 1.0; // множитель стоимости улучшений, увеличивается при каждом улучшении",
            "//accepted = 0; // принял ли игрок предложение спонсировать постройку",
            "",
            "//NRangers = 1; // количество кораблей",
            "//LvlFreq = 1; // частота постройки",
            "//NItems = 1; // количество оборудки",
            "//LvlSkills = 1; // повышение навыков",
            "//LvlUpgrade = 1; // улучшение оборудки",
            "",
            "money = newarray(5); // начальный капитал рейнджеров, увеличивается при каждом улучшении",
            "LvlHullSize = newarray(5); // размер корпуса",
            "LvlHullAcrin = newarray(5); // качество акрина",
            "LvlEq = newarray(5); // качество оборудки",
            "for (i = 0; i < 5; i = i + 1) {",
            "    money[i] = 0;",
            "    money[i] = 10.0;",
            "    LvlHullSize[i] = 1;",
            "    LvlHullAcrin[i] = 1;",
            "    LvlEq[i] = 1;",
            "}",
            "",
            "// Старые текстовые массивы сохраняем в исходном размере только ради схемы",
            "// существующих сохранений. Интерфейс читает строки через функции ниже.",
            "StrLvlFreq = newarray(5);",
            "StrLvlFreq[0] = \"рассылаем объявления пилотам и выпускникам лётных школ; счета за топливо они читают охотнее\";",
            "StrLvlFreq[1] = \"ставим вербовочные стойки в центрах рейнджеров и рядом с особенно скучными биржами труда\";",
            "StrLvlFreq[2] = \"устраиваем открытые наборы на планетах и закрытые переклички после них\";",
            "StrLvlFreq[3] = \"запустили межпланетную рекламу службы; после ролика даже доминаторы прислали жалобу\";",
            "StrLvlFreq[4] = \"ведём кампанию по всей Коалиции; плакаты героические, мелкий шрифт честный\";",
            "",
            "StrNRangers = newarray(5);",
            "StrNRangers[0] = \"одного рейнджера, зато без споров за премию\";",
            "StrNRangers[1] = \"двух рейнджеров — уже можно назначать старшего\";",
            "StrNRangers[2] = \"группу из трёх рейнджеров\";",
            "StrNRangers[3] = \"звено из четырёх рейнджеров\";",
            "StrNRangers[4] = \"полноценный отряд из пяти рейнджеров\";",
            "",
            "StrNItems = newarray(5);",
            "StrNItems[0] = \"минимальный комплект: летает, стреляет, только гарантия кончилась — ровно перед выдачей\";",
            "StrNItems[1] = \"базовый комплект: всё необходимое и ещё радар либо второе орудие — что первым найдут на складе\";",
            "StrNItems[2] = \"стандартный комплект: второе орудие, радар и, если повезёт, система без пометки «на ремонт»\";",
            "StrNItems[3] = \"расширенный комплект: два орудия, радар и одна-две полезные системы; точное число знает только кладовщик\";",
            "StrNItems[4] = \"полный комплект: всё, что удалось втиснуть в корабль, и инструкция по борьбе с перегрузом\";",
            "",
            "StrLvlSkills = newarray(5);",
            "StrLvlSkills[0] = \"проводим короткий инструктаж и очень выразительно показываем на аварийный выход\";",
            "StrLvlSkills[1] = \"проводим базовую подготовку и проверку пригодности кандидатов; тех, кто читает инструкцию до аварии, принимаем вне очереди\";",
            "StrLvlSkills[2] = \"проводим стандартный курс подготовки: пилотирование, стрельба и возвращение корабля хотя бы с большинством деталей\";",
            "StrLvlSkills[3] = \"проводим углублённую подготовку с тактикой, стрельбой и убедительным видом на экзамене\";",
            "StrLvlSkills[4] = \"берём опытных пилотов и учим их всему, включая искусство не спорить с автопилотом\";",
            "",
            "StrLvlUpgrade = newarray(5);",
            "StrLvlUpgrade[0] = \"молодой техник Малокской академии; диплом ещё тёплый, гаечный ключ уже боевой\";",
            "StrLvlUpgrade[1] = \"опытный пеленгский инженер, способный починить двигатель и продать оставшиеся детали\";",
            "StrLvlUpgrade[2] = \"человеческий специалист по боевым системам и внезапным переработкам\";",
            "StrLvlUpgrade[3] = \"фэянский научный консультант: сначала докажет, что поломки нет, потом устранит её\";",
            "StrLvlUpgrade[4] = \"гаальский мастер модификаций, который называет каждый болт «элементом гармонии»\";",
            "",
            "StrLvlHullSize = newarray(5);",
            "StrLvlHullSize[0] = \"корпус малого тоннажа — зато парковка бесплатная\";",
            "StrLvlHullSize[1] = \"корпус лёгкого класса\";",
            "StrLvlHullSize[2] = \"корпус среднего класса\";",
            "StrLvlHullSize[3] = \"корпус тяжёлого класса\";",
            "StrLvlHullSize[4] = \"корпус предельного тоннажа, заметный даже коалиционной бухгалтерии\";",
            "",
            "StrLvlHullAcrin = newarray(5);",
            "StrLvlHullAcrin[0] = \"в полевых мастерских центра: быстро, смело и без лишних вопросов к проводке\";",
            "StrLvlHullAcrin[1] = \"в стационарных доках, где хотя бы свет включается с первого раза\";",
            "StrLvlHullAcrin[2] = \"на специальных площадках Коалиции, которые ещё не успели переименовать в склады\";",
            "StrLvlHullAcrin[3] = \"на базе центра под надзором инженеров и одного крайне подозрительного огнетушителя\";",
            "StrLvlHullAcrin[4] = \"на сертифицированном заводе, где акрин считается важнее пунктуальности\";",
            "",
            "StrLvlEq = newarray(5);",
            "StrLvlEq[0] = \"берём на вторичном рынке и проверяем особенно тщательно — продавца тоже\";",
            "StrLvlEq[1] = \"выкупаем у действующих и бывших пилотов вместе с их невероятными историями\";",
            "StrLvlEq[2] = \"собираем в мастерских центра из новых деталей и очень опытных старых\";",
            "StrLvlEq[3] = \"закупаем на планетарных военных складах; накладные почти всегда совпадают\";",
            "StrLvlEq[4] = \"заказываем на заводах Коалиции по чертежам, пережившим уже три комиссии\";",
            "",
            "// Рабочий UI получает строки напрямую и не зависит от persistent-массивов.",
            "function TextLvlFreq(level) {",
            "    if (level == 1) result = \"рассылаем объявления пилотам и выпускникам лётных школ; счета за топливо они читают охотнее\"; else",
            "    if (level == 2) result = \"ставим вербовочные стойки в центрах рейнджеров и рядом с особенно скучными биржами труда\"; else",
            "    if (level == 3) result = \"устраиваем открытые наборы на планетах и закрытые переклички после них\"; else",
            "    if (level == 4) result = \"запустили межпланетную рекламу службы; после ролика даже доминаторы прислали жалобу\"; else",
            "    result = \"ведём кампанию по всей Коалиции; плакаты героические, мелкий шрифт честный\";",
            "}",
            "function TextNRangers(level) {",
            "    if (level == 1) result = \"одного рейнджера, зато без споров за премию\"; else",
            "    if (level == 2) result = \"двух рейнджеров — уже можно назначать старшего\"; else",
            "    if (level == 3) result = \"группу из трёх рейнджеров\"; else",
            "    if (level == 4) result = \"звено из четырёх рейнджеров\"; else",
            "    result = \"полноценный отряд из пяти рейнджеров\";",
            "}",
            "function TextNItems(level) {",
            "    if (level == 1) result = \"минимальный комплект: летает, стреляет, только гарантия кончилась — ровно перед выдачей\"; else",
            "    if (level == 2) result = \"базовый комплект: всё необходимое и ещё радар либо второе орудие — что первым найдут на складе\"; else",
            "    if (level == 3) result = \"стандартный комплект: второе орудие, радар и, если повезёт, система без пометки «на ремонт»\"; else",
            "    if (level == 4) result = \"расширенный комплект: два орудия, радар и одна-две полезные системы; точное число знает только кладовщик\"; else",
            "    result = \"полный комплект: всё, что удалось втиснуть в корабль, и инструкция по борьбе с перегрузом\";",
            "}",
            "function TextLvlSkills(level) {",
            "    if (level == 1) result = \"проводим короткий инструктаж и очень выразительно показываем на аварийный выход\"; else",
            "    if (level == 2) result = \"проводим базовую подготовку и проверку пригодности кандидатов; тех, кто читает инструкцию до аварии, принимаем вне очереди\"; else",
            "    if (level == 3) result = \"проводим стандартный курс подготовки: пилотирование, стрельба и возвращение корабля хотя бы с большинством деталей\"; else",
            "    if (level == 4) result = \"проводим углублённую подготовку с тактикой, стрельбой и убедительным видом на экзамене\"; else",
            "    result = \"берём опытных пилотов и учим их всему, включая искусство не спорить с автопилотом\";",
            "}",
            "function TextLvlUpgrade(level) {",
            "    if (level == 1) result = \"молодой техник Малокской академии; диплом ещё тёплый, гаечный ключ уже боевой\"; else",
            "    if (level == 2) result = \"опытный пеленгский инженер, способный починить двигатель и продать оставшиеся детали\"; else",
            "    if (level == 3) result = \"человеческий специалист по боевым системам и внезапным переработкам\"; else",
            "    if (level == 4) result = \"фэянский научный консультант: сначала докажет, что поломки нет, потом устранит её\"; else",
            "    result = \"гаальский мастер модификаций, который называет каждый болт «элементом гармонии»\";",
            "}",
            "function TextLvlHullSize(level) {",
            "    if (level == 1) result = \"корпус малого тоннажа — зато парковка бесплатная\"; else",
            "    if (level == 2) result = \"корпус лёгкого класса\"; else",
            "    if (level == 3) result = \"корпус среднего класса\"; else",
            "    if (level == 4) result = \"корпус тяжёлого класса\"; else",
            "    result = \"корпус предельного тоннажа, заметный даже коалиционной бухгалтерии\";",
            "}",
            "function TextLvlHullAcrin(level) {",
            "    if (level == 1) result = \"в полевых мастерских центра: быстро, смело и без лишних вопросов к проводке\"; else",
            "    if (level == 2) result = \"в стационарных доках, где хотя бы свет включается с первого раза\"; else",
            "    if (level == 3) result = \"на специальных площадках Коалиции, которые ещё не успели переименовать в склады\"; else",
            "    if (level == 4) result = \"на базе центра под надзором инженеров и одного крайне подозрительного огнетушителя\"; else",
            "    result = \"на сертифицированном заводе, где акрин считается важнее пунктуальности\";",
            "}",
            "function TextLvlEq(level) {",
            "    if (level == 1) result = \"берём на вторичном рынке и проверяем особенно тщательно — продавца тоже\"; else",
            "    if (level == 2) result = \"выкупаем у действующих и бывших пилотов вместе с их невероятными историями\"; else",
            "    if (level == 3) result = \"собираем в мастерских центра из новых деталей и очень опытных старых\"; else",
            "    if (level == 4) result = \"закупаем на планетарных военных складах; накладные почти всегда совпадают\"; else",
            "    result = \"заказываем на заводах Коалиции по чертежам, пережившим уже три комиссии\";",
            "}"
          ]
        },
        {
          "Type": "Top",
          "Name": "",
          "Pos.x": 120,
          "Pos.y": 565,
          "Parent": -1,
          "#": 52,
          "Code.Type": "Turn",
          "Code": [
            "if (CurTurn() >= buy_date + BuildingTime()) {",
            "    // Обновляем дату постройки",
            "    buy_date = CurTurn();",
            "    // Покупаем NRangers рейнджеров на каждом ЦР",
            "    for (j = 0; j < GalaxyStars(); j = j + 1) {",
            "        dword ranger_star = GalaxyStar(j);",
            "        if (!ranger_star) continue;",
            "",
            "        dword ranger_center = StarRuins(ranger_star, 'RC');",
            "        if (!ranger_center) continue;",
            "",
            "        for (k = 0; k < NRangers; k = k + 1)",
            "            BuyNewRanger(ranger_center, k);",
            "    }",
            "}",
            "if(debug) {",
            "  SFT('CurTurn: ' + CurTurn() + ' Building time: ' + BuildingTime() + ' Build date: ' + buy_date + BuildingTime() + ' Last build: ' + buy_date);",
            "}"
          ]
        },
        {
          "Type": "Top",
